# Configuration never lives in code.
# The publishable key is public anyway — these variables are not about secrecy,
# but about dev and production never being hardcoded.
# Copy this to .env.local for local development, and set the same variables in
# Vercel separately for Production and for Preview.
# A Preview deployment NEVER receives the production URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
